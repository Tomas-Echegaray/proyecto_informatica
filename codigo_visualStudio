        /// ---------------------------------------------------------------

        public void PonRespuesta(string mensaje)
        {
            RespuestasServidorLabel.Text = mensaje;
        }

        // Devuelve las partes del mensaje desde la posición "desde" volviendo a unirlas con '/'
        private static string Resto(string[] partes, int desde)
        {
            if (desde >= partes.Length)
                return "";
            return string.Join("/", partes, desde, partes.Length - desde);
        }

        // Aquí llega CADA mensaje del servidor y según su código llamamos a una función u otra
        private void ProcesarMensaje(string mensaje)
        {
            try
            {
                string[] partes = mensaje.Split('/');
                int codigo = Convert.ToInt32(partes[0]);

                switch (codigo)
                {
                    case 1: RespuestaRegistro(partes); break;       //1/OK|NO/mensaje
                    case 2: RespuestaLogin(partes); break;          //2/Correcto|NO/mensaje
                    case 3:                                         //3/SI|NO|ERROR/mensaje
                        PonRespuesta("Consulta pistola: " + Resto(partes, 2));
                        break;
                    case 4:                                         //4/numero
                        if (partes[1] == "ERROR")
                            PonRespuesta("Error: " + Resto(partes, 2));
                        else
                            PonRespuesta("Número de jugadores: " + partes[1]);
                        break;
                    case 5:                                         //5/jugador-tiempo
                        if (partes[1] == "ERROR")
                            PonRespuesta("Error: " + Resto(partes, 2));
                        else
                            PonRespuesta("Jugador con más tiempo: " + partes[1]);
                        break;
                    case 6: PonConectados(partes); break;           //6/n/nombre1/nombre2... (se actualiza SIEMPRE, solo)
                    case 7: RecibirInvitacion(partes); break;       //7/id/anfitrion
                    case 8: ResultadoInvitacion(partes); break;     //8/id/Si/jugadores...  o  8/id/No/rechazan...
                    case 9: PintarEstado(partes); break;            //9/id/turno/zx/zy/n/(nombre/x/y/vivo)...
                    case 10: FinPartida(partes); break;             //10/id/Victoria|Derrota
                    case 11:                                        //11/mensaje de error
                        MessageBox.Show(Resto(partes, 1), "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        break;
                    case 12: PonRespuesta(Resto(partes, 1)); break; //12/mensaje de información
                    case 13:                                        //13/jugador/texto (chat)
                        ChatListBox.Items.Add(partes[1] + ": " + Resto(partes, 2));
                        ChatListBox.TopIndex = ChatListBox.Items.Count - 1;     //Para que se vea siempre el último mensaje
                        break;
                }
            }
            catch (Exception)
            {
                PonRespuesta("Mensaje inesperado del servidor: " + mensaje);
            }
        }

        private void RespuestaRegistro(string[] partes)
        {
            string mensaje = Resto(partes, 2);
            PonRespuesta("Respuesta de registro: " + mensaje);
            if (partes[1] != "OK")
                MessageBox.Show(mensaje, "Error de registro", MessageBoxButtons.OK, MessageBoxIcon.Warning);
        }

        private void RespuestaLogin(string[] partes)
        {
            string mensaje = Resto(partes, 2);
            if (partes[1] == "Correcto")
            {
                NombreCliente = nombrePendiente;    //Ahora sí: ya tenemos sesión
                BloqueaLogin(true);
                PonRespuesta("Sesión iniciada como " + NombreCliente);
            }
            else
            {
                nombrePendiente = "";
                PonRespuesta("Respuesta de inicio de sesión: " + mensaje);
                MessageBox.Show(mensaje, "Error de inicio de sesión", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

