        private void ConfigurarTablero()
        {
            TableroDataGridView.ReadOnly = true;
            TableroDataGridView.ColumnCount = COLUMNAS;
            TableroDataGridView.RowCount = FILAS;

            TableroDataGridView.ScrollBars = ScrollBars.None;
            TableroDataGridView.RowHeadersVisible = false;
            TableroDataGridView.ColumnHeadersVisible = false;
            TableroDataGridView.AllowUserToResizeColumns = false;
            TableroDataGridView.AllowUserToResizeRows = false;

            //En el Designer las casillas estaban en "AllCells" (se agrandan para que quepa el texto) y por eso el tablero se salía
            //de la pantalla. Las ponemos fijas y el tamaño lo decidimos nosotros en AjustarTablero
            TableroDataGridView.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.None;
            TableroDataGridView.AutoSizeRowsMode = DataGridViewAutoSizeRowsMode.None;
            TableroDataGridView.Anchor = AnchorStyles.Top | AnchorStyles.Left;      //Que no cambie de tamaño solo al mover la ventana

            //Letra pequeña y centrada para que la inicial del jugador quepa en la casilla
            TableroDataGridView.DefaultCellStyle.Padding = new Padding(0);
            TableroDataGridView.DefaultCellStyle.Font = new Font("Microsoft Sans Serif", 7F, FontStyle.Bold);
            TableroDataGridView.DefaultCellStyle.Alignment = DataGridViewContentAlignment.MiddleCenter;

            AjustarTablero();
        }

        // Calcula el tamaño de las casillas para que las 30 columnas y las 34 filas se vean enteras en la ventana
        private void AjustarTablero()
        {
            if (this.WindowState == FormWindowState.Minimized)
                return;

            //Espacio disponible: desde donde empieza el tablero hasta el borde derecho de la ventana,
            //y hacia abajo hasta el panel4 (que está justo debajo del tablero)
            int ancho = this.ClientSize.Width - TableroDataGridView.Left - 10;
            int alto = panel4.Top - TableroDataGridView.Top - 5;

            //Casillas cuadradas: el lado es el más pequeño que hace que quepan todas
            int lado = Math.Min(ancho / COLUMNAS, alto / FILAS);
            if (lado < 4)
                lado = 4;

            for (int j = 0; j < COLUMNAS; j++)
                TableroDataGridView.Columns[j].Width = lado;
            for (int i = 0; i < FILAS; i++)
                TableroDataGridView.Rows[i].Height = lado;

            //El control se ajusta justo al tamaño de las casillas (+2 por el borde)
            TableroDataGridView.Width = lado * COLUMNAS + 2;
            TableroDataGridView.Height = lado * FILAS + 2;
        }

        // Escribe una ficha en una casilla y la colorea
        private void PintaCelda(int x, int y, string texto, Color fondo, Color letra)
        {
            DataGridViewCell celda = TableroDataGridView.Rows[y].Cells[x];
            celda.Value = texto;
            celda.Style.BackColor = fondo;
            celda.Style.SelectionBackColor = fondo;     //Para que no se ponga azul al hacer clic
            celda.Style.ForeColor = letra;
            celda.Style.SelectionForeColor = letra;
            celdasPintadas.Add(new Point(x, y));
        }

        // Quita todas las fichas del tablero
        private void LimpiarTablero()
        {
            foreach (Point p in celdasPintadas)
            {
                DataGridViewCell celda = TableroDataGridView.Rows[p.Y].Cells[p.X];
                celda.Value = null;
                celda.Style.BackColor = Color.Empty;
                celda.Style.SelectionBackColor = Color.Empty;
                celda.Style.ForeColor = Color.Empty;
                celda.Style.SelectionForeColor = Color.Empty;
            }
            celdasPintadas.Clear();
            TableroDataGridView.ClearSelection();
        }

        // CLIC EN EL TABLERO: pedimos al servidor mover nuestro jugador a esa casilla
        private void TableroDataGridView_CellClick(object sender, DataGridViewCellEventArgs e)
        {
            if (!partidaIniciada || e.RowIndex < 0 || e.ColumnIndex < 0)
                return;

            int i = e.RowIndex;     // fila    (Y)
            int j = e.ColumnIndex;  // columna (X)

            if (miTurno != NombreCliente)
            {
                PonRespuesta("No es tu turno, espera a " + miTurno + ".");
                return;
            }
            if (Math.Abs(miX - j) + Math.Abs(miY - i) != 1)
            {
                MessageBox.Show("Solo puedes moverte a una casilla adyacente (arriba, abajo, izquierda o derecha).", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // Petición: 10/id/x/y
            EnviarAlServidor("10/" + partidaActual + "/" + j + "/" + i);
        }
    }
