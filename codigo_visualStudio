        // Nos conectamos al servidor C (si no lo estábamos ya) y arrancamos el thread que atiende sus mensajes
        private bool ConectarServidor()
        {
            if (server != null && server.Connected)
                return true;

            try
            {
                IPEndPoint ipep = new IPEndPoint(ip, PUERTO);
                server = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
                server.Connect(ipep);

                //Poner en marcha el thread que atenderá los mensajes del servidor
                ThreadStart ts = delegate { AtenderServidor(); };
                atender = new Thread(ts);
                atender.IsBackground = true;    //Así el thread se cierra solo al cerrar la ventana
                atender.Start();
                return true;
            }
            catch (Exception ex)
            {
                MessageBox.Show("No se pudo conectar con el servidor: " + ex.Message, "Error de red", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return false;
            }
        }

        // Manda un mensaje al servidor (le ponemos un '\n' al final para que el servidor separe los mensajes)
        private void EnviarAlServidor(string mensaje)
        {
            if (server == null || !server.Connected)
            {
                MessageBox.Show("No estás conectado al servidor. Inicia sesión primero.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            try
            {
                server.Send(Encoding.UTF8.GetBytes(mensaje + "\n"));
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error al enviar al servidor: " + ex.Message, "Error de red", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// IMPORTANTE
        /// Este es el THREAD que se encarga de recibir TODOS los mensajes del servidor
        /// IMPORTANTE
        private void AtenderServidor()
        {
            Socket socket = server;
            byte[] buffer = new byte[4096];

            while (true)
            {
                int bytesRecibidos;
                try
                {
                    //Recibimos lo que manda el servidor C (se queda esperando aquí hasta que llega algo)
                    bytesRecibidos = socket.Receive(buffer);
                }
                catch (Exception)
                {
                    bytesRecibidos = 0;
                }
                if (bytesRecibidos <= 0)
                    break;      //El servidor ha cerrado la conexión

                //Pueden llegar varios mensajes pegados: cada uno acaba en '\n', así que los separamos
                string recibido = Encoding.UTF8.GetString(buffer, 0, bytesRecibidos);
                string[] mensajes = recibido.Split('\n');
                foreach (string mensaje in mensajes)
                {
                    if (mensaje != "")
                    {
                        try
                        {
                            //Un thread no puede tocar los controles de la ventana: le pedimos al hilo de la interfaz que ejecute ProcesarMensaje
                            this.Invoke(new DelegadoParaProcesar(ProcesarMensaje), new object[] { mensaje });
                        }
                        catch (Exception)
                        {
                            return;     //La ventana ya se ha cerrado
                        }
                    }
                }
            }

            //Si llegamos aquí es que se ha perdido la conexión
            if (!cerrando)
            {
                try
                {
                    this.Invoke(new DelegadoParaProcesar(ConexionPerdida), new object[] { "" });
                }
                catch (Exception)
                {
                }
            }
        }

        // Se ha perdido la conexión: lo dejamos todo como al principio
        private void ConexionPerdida(string mensaje)
        {
            server = null;
            NombreCliente = "";
            partidaActual = -1;
            partidaIniciada = false;
            ConectadosListBox.Items.Clear();
            PartidasListBox.Items.Clear();
            LimpiarTablero();
            BloqueaLogin(false);
            MessageBox.Show("Se ha perdido la conexión con el servidor.", "Error de red", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }


