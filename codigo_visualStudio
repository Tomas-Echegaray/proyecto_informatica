        // Comprueba usuario y contraseña antes de mandarlos
        private bool DatosValidos()
        {
            string usuario = NombreTextBox.Text.Trim();
            if (usuario == "" || ConTextBox.Text == "")
            {
                MessageBox.Show("Por favor, introduce usuario y contraseña.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }
            if (usuario.Length > 19 || ConTextBox.Text.Length > 29)
            {
                MessageBox.Show("El usuario puede tener como máximo 19 caracteres y la contraseña 29.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }
            if (usuario.Contains("-") || usuario.Contains("/"))
            {
                MessageBox.Show("El nombre de usuario no puede contener '-' ni '/'.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }
            return true;
        }

        // BOTÓN REGISTRARSE (se conecta solo y envía el registro)
        private void RegistraButton_Click_1(object sender, EventArgs e)
        {
            if (!DatosValidos())
                return;
            if (!ConectarServidor())
                return;

            // Enviamos formato de registro: 1/usuario-contraseña
            EnviarAlServidor("1/" + NombreTextBox.Text.Trim() + "-" + ConTextBox.Text);
        }

        // BOTÓN INICIAR SESIÓN (se conecta solo y envía el login)
        private void IniciarSesionButton_Click(object sender, EventArgs e)
        {
            if (NombreCliente != "")
            {
                MessageBox.Show("Ya has iniciado sesión como " + NombreCliente + ".", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }
            if (!DatosValidos())
                return;
            if (!ConectarServidor())
                return;

            // Enviamos los datos en el formato del protocolo: 2/usuario-contraseña
            nombrePendiente = NombreTextBox.Text.Trim();
            EnviarAlServidor("2/" + nombrePendiente + "-" + ConTextBox.Text);
        }

        // DESCONECTAR AL CERRAR LA VENTANA
        private void InterfazForm_FormClosing(object sender, FormClosingEventArgs e)
        {
            cerrando = true;
            try
            {
                if (server != null && server.Connected)
                {
                    server.Send(Encoding.UTF8.GetBytes("0/\n"));    //Código 0: nos desconectamos
                    server.Close();
                }
            }
            catch (Exception)
            {
            }
        }

        /// VERSION 4: PROTOCOLO DE INVITACIÓN (parte del anfitrión)
        // BOTÓN INVITAR: invitamos a los jugadores que estén seleccionados en la lista de conectados (Ctrl + clic para varios)
        private void InivitarButton_Click(object sender, EventArgs e)
        {
            if (NombreCliente == "")
            {
                MessageBox.Show("Inicia sesión antes de invitar a alguien.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            if (ConectadosListBox.SelectedItems.Count == 0)
            {
                MessageBox.Show("Selecciona uno o varios jugadores de la lista de conectados.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Formato de la petición: 7/invitado1/invitado2/...
            string mensaje = "7";
            foreach (object seleccionado in ConectadosListBox.SelectedItems)
            {
                string invitado = seleccionado.ToString();
                if (invitado == NombreCliente)
                {
                    MessageBox.Show("No puedes invitarte a ti mismo.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
                mensaje = mensaje + "/" + invitado;
            }
            EnviarAlServidor(mensaje);
            //Las respuestas llegarán por el thread (mensajes 12, 11 y 8)
        }

        // BOTÓN INICIAR PARTIDA: solo se lo pedimos al servidor, él decide dónde aparece cada uno
        private void IniciarPartidaButton_Click(object sender, EventArgs e)
        {
            if (partidaActual == -1)
            {
                MessageBox.Show("Todavía no tienes una partida lista. Invita a otros jugadores y espera a que todos acepten.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }
            if (partidaIniciada)
            {
                MessageBox.Show("La partida ya está en marcha.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }
            if (NombreCliente != anfitrion)
            {
                MessageBox.Show("Solo el anfitrión (" + anfitrion + ") puede iniciar la partida.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // Petición: 9/id
            EnviarAlServidor("9/" + partidaActual);
        }

        // BOTÓN CONSULTAR (peticiones 3, 4 y 5)
        private void ConsultarButton_Click_1(object sender, EventArgs e)
        {
            int codigoConsulta;
            string parametro;

            if (PistolaRadioButton.Checked)
            {
                codigoConsulta = 3;
                parametro = JugadorTextBox.Text.Trim();
                if (parametro == "")
                {
                    MessageBox.Show("Introduce el nombre del jugador.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
            }
            else if (NumJugadoresRadioButton.Checked || MasTiempoRadioButton.Checked)
            {
                if (NumJugadoresRadioButton.Checked)
                    codigoConsulta = 4;
                else
                    codigoConsulta = 5;
                parametro = PartidaTextBox.Text.Trim();
                if (parametro == "")
                {
                    MessageBox.Show("Introduce el código de la partida.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
            }
            else
            {
                MessageBox.Show("Selecciona una de las opciones de consulta.", "Atención", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            EnviarAlServidor(codigoConsulta + "/" + parametro);
        }

        // BOTÓN ENVIAR (chat): mandamos el texto al servidor y él se lo reenvía a todos los de nuestra partida
