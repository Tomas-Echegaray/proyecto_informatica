        // Mensaje 6: la lista de conectados llega SOLA cada vez que cambia
        public void PonConectados(string[] partes)
        {
            ConectadosListBox.Items.Clear();
            for (int i = 2; i < partes.Length; i++)
            {
                string nombreLimpio = partes[i].Split('\0')[0];
                if (!string.IsNullOrWhiteSpace(nombreLimpio))
                    ConectadosListBox.Items.Add(nombreLimpio);
            }
        }

        /// VERSION 4: PROTOCOLO DE INVITACIÓN (parte del invitado)
        // Mensaje 7: "7/id/anfitrion" -> nos han invitado. Se lo mostramos al usuario y mandamos su respuesta
        private void RecibirInvitacion(string[] partes)
        {
            string id = partes[1];
            string invitador = partes[2];

            DialogResult respuesta = MessageBox.Show(invitador + " te invita a jugar una partida. Aceptas?",
                "Invitación de partida", MessageBoxButtons.YesNo, MessageBoxIcon.Question);

            if (respuesta == DialogResult.Yes)
            {
                EnviarAlServidor("8/" + id + "/Si");
                PonRespuesta("Has aceptado la invitación de " + invitador + ". Esperando al resto de jugadores...");
            }
            else
            {
                EnviarAlServidor("8/" + id + "/No");
                PonRespuesta("Has rechazado la invitación de " + invitador + ".");
            }
        }

        /// VERSION 4: PROTOCOLO DE INVITACIÓN (resultado, lo reciben el anfitrión Y los invitados)
        // Mensaje 8: "8/id/Si/jugadores..." (todos aceptaron, se juega)  o  "8/id/No/rechazan..." (no se juega)
        private void ResultadoInvitacion(string[] partes)
        {
            string id = partes[1];
            string nombres = string.Join(", ", partes, 3, partes.Length - 3);   //Los nombres que vienen después del Si/No

            if (partes[2] == "Si")
            {
                partidaActual = Convert.ToInt32(id);
                anfitrion = partes[3];      //El primer nombre de la lista es el anfitrión
                PartidasListBox.Items.Clear();
                PartidasListBox.Items.Add("Partida " + id + " | Jugadores: " + nombres);

                string aviso = "Todos han aceptado la invitación, se jugará la partida!\nJugadores: " + nombres;
                if (NombreCliente == anfitrion)
                    aviso = aviso + "\n\nPulsa 'Iniciar partida' cuando quieras empezar.";
                else
                    aviso = aviso + "\n\nEspera a que " + anfitrion + " inicie la partida.";
                PonRespuesta("Todos han aceptado. ¡Se jugará la partida!");
                MessageBox.Show(aviso, "Resultado de la invitación", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            else
            {
                partidaActual = -1;
                anfitrion = "";
                PartidasListBox.Items.Clear();
                PonRespuesta("No se jugará la partida: " + nombres + " ha rechazado la invitación.");
                MessageBox.Show("No se jugará la partida porque ha rechazado la invitación: " + nombres,
                    "Resultado de la invitación", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

        // Mensaje 9: "9/id/turno/zx/zy/n/nombre/x/y/vivo/..." -> el servidor nos manda el tablero completo y lo dibujamos
        private void PintarEstado(string[] partes)
        {
            partidaActual = Convert.ToInt32(partes[1]);
            miTurno = partes[2];
            int zx = Convert.ToInt32(partes[3]);
            int zy = Convert.ToInt32(partes[4]);
            int n = Convert.ToInt32(partes[5]);

            partidaIniciada = true;
            LimpiarTablero();
            PintaCelda(zx, zy, "Z", Color.Firebrick, Color.White);      //El zombie, en rojo

            bool yoVivo = false;
            for (int k = 0; k < n; k++)
            {
                int pos = 6 + 4 * k;        //Cada jugador ocupa 4 partes: nombre, x, y, vivo
                string nombre = partes[pos];
                int x = Convert.ToInt32(partes[pos + 1]);
                int y = Convert.ToInt32(partes[pos + 2]);
                bool vivo = (partes[pos + 3] == "1");

                if (nombre == NombreCliente)
                {
                    miX = x;
                    miY = y;
                    yoVivo = vivo;
                }
                if (vivo)
                {
                    //Los jugadores se escriben con la primera letra de su nombre (el nuestro, en dorado)
                    Color fondo = Color.LightGreen;
                    if (nombre == NombreCliente)
                        fondo = Color.Gold;
                    PintaCelda(x, y, nombre.Substring(0, 1).ToUpper(), fondo, Color.Black);
                }
            }
            TableroDataGridView.ClearSelection();

            if (!yoVivo)
                PonRespuesta("Te han atrapado. Sigue la partida como espectador.");
            else if (miTurno == NombreCliente)
                PonRespuesta("¡Es tu turno! Haz clic en una casilla adyacente (arriba, abajo, izquierda o derecha).");
            else
                PonRespuesta("Turno de " + miTurno + "...");
        }

        // Mensaje 10: "10/id/Victoria" o "10/id/Derrota" -> se acabó la partida
        private void FinPartida(string[] partes)
        {
            partidaIniciada = false;
            partidaActual = -1;
            anfitrion = "";
            miTurno = "";
            LimpiarTablero();
            PartidasListBox.Items.Clear();

            if (partes[2] == "Victoria")
                MessageBox.Show("¡Habéis sobrevivido a todas las rondas!", "¡Victoria!", MessageBoxButtons.OK, MessageBoxIcon.Information);
            else
                MessageBox.Show("El zombie ha acabado con todos los jugadores.", "Fin de la partida", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }


